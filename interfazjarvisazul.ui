    </property>
    <property name="styleSheet">
      <string notr="true">
QMainWindow, QWidget#centralwidget { background-color:#0B1C34; color:#DDECFB; font-family:"Segoe UI"; }
QFrame#headerHUD { background-color:#051625; border-bottom:2px solid #1B7DBF; }
QLabel#lblTitulo {font-size:24px; font-weight:800; letter-spacing:3px; color:#F2FCFF; background:transparent;}
QLabel#lblSubtitulo {font-size:10px; letter-spacing:1px; color:#93BADA; background:transparent;}
QLabel#lblSistema {font-size:10px; font-weight:600; color:#6FE4E8; background:transparent;}
QLabel#lblReactor {background:transparent; border:0;}
QFrame#barraAcciones {background-color:#112642; border-bottom:1px solid #284968;}
QFrame#panelProyecto, QFrame#panelEditor, QFrame#panelConsola, QFrame#panelVariables, QFrame#panelAnalisis { background-color:#122845; border:1px solid #2B496A; border-radius:10px; }
QLabel {color:#DAE7F9; background:transparent; font-size:12px;}
QLabel#lblProyecto, QLabel#lblVariables, QLabel#lblAnalisis, QLabel#lblConsola, QLabel#lblCodigo {font-size:14px; font-weight:700; color:#F5FAFF;}
QLabel#lblSeccion, QLabel#lblPestana, QLabel#lblInfoCodigo, QLabel#lblVersion { color:#8CACCE; font-size:11px; }
QLabel#lblEstadoAnalisis {color:#A9BCD3; font-weight:700; font-size:14px;}
QLabel#lblAnalisisDetalle {color:#9DB7D2; font-size:11px;}
QLabel#lblEnergiaFinal {background:#1A385B; border-radius:8px; color:#DDEDFC; padding:10px; font-weight:bold;}
QLabel#lblLexico, QLabel#lblSintactico, QLabel#lblSemantico {background:#1B354F; border-radius:6px; padding:8px; font-size:11px; color:#A9BED7;}
QPushButton {background:#17324F; color:#EAF4FE; border:1px solid #2F5378; border-radius:7px; font-weight:600; padding:7px 10px; min-height:23px;}
QPushButton:hover {background:#23517A; border:1px solid #4F98CF;}
QPushButton:pressed {background:#0F3B60;}
QPushButton#btnEjecutar {background:#1276C4; border-color:#188ADF; color:white;}
QPushButton#btnAnalizar {background:#145E9D; border-color:#267FB8; color:white;}
QPushButton#btnAST {background:#185FAD; border-color:#2B75C2; color:white;}
QPushButton#btnBlanco, QPushButton#btnAzul {min-width:71px; font-size:11px;}
QPushButton#btnAzul {background:#D6EAF8; border-color:#D6EAF8; color:#113456;}
QPlainTextEdit {background:#0B1B33; color:#E0ECFF; border:1px solid #264365; border-radius:8px; padding:9px; font-family:Consolas; font-size:13px; selection-background-color:#2363A1;}
QPlainTextEdit:focus {border:1px solid #2189CE;}
QLineEdit {background:#0C2039; color:#E5F1FF; border:1px solid #28486B; border-radius:7px; padding:7px 10px; min-height:19px;}
QTableWidget, QTreeWidget {background:#0C2039; color:#DDEBFA; border:1px solid #294668; border-radius:8px; gridline-color:#243D5B; alternate-background-color:#142C4A;}
QTableWidget::item {padding:6px;}
QTreeWidget::item {min-height:28px; padding:3px; border-radius:5px;}
QTreeWidget::item:selected {background:#1A4C7B; color:#FFFFFF;}
QHeaderView::section {background:#1C375A; color:#C2D8F0; border:0; border-right:1px solid #355477; padding:7px; font-size:10px; font-weight:700;}
QScrollBar:vertical, QScrollBar:horizontal {background:#11233C; width:11px; height:11px; border:0;}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {background:#385A7B; border-radius:5px; min-height:24px; min-width:24px;}
</string>
