  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#centralwidget { background-color:#F4F7FB; color:#233653; font-family:&quot;Segoe UI&quot;; }
QFrame#headerHUD {background-color:#051625; border-bottom:2px solid #1B7DBF;}
QLabel#lblTitulo {font-size:24px; font-weight:800; letter-spacing:3px; color:#F2FCFF; background:transparent;}
QLabel#lblSubtitulo {font-size:10px; letter-spacing:1px; color:#93BADA; background:transparent;}
QLabel#lblSistema {font-size:10px; font-weight:600; color:#6FE4E8; background:transparent;}
QLabel#lblReactor {background:transparent; border:0;}
QFrame#barraAcciones {background:#FFFFFF; border-bottom:1px solid #E2E8F0;}
QFrame#panelProyecto, QFrame#panelEditor, QFrame#panelConsola, QFrame#panelVariables, QFrame#panelAnalisis {background:#FFFFFF; border:1px solid #DAE4F0; border-radius:10px;}
QLabel {color:#213551; background:transparent; font-size:12px;}
QLabel#lblProyecto, QLabel#lblVariables, QLabel#lblAnalisis, QLabel#lblConsola, QLabel#lblCodigo {font-size:14px; font-weight:700; color:#1B2E48;}
QLabel#lblSeccion, QLabel#lblPestana, QLabel#lblInfoCodigo, QLabel#lblVersion {color:#697E9B; font-size:11px;}
QLabel#lblEstadoAnalisis {color:#657D98; font-size:14px; font-weight:700;}
QLabel#lblAnalisisDetalle {color:#69819A; font-size:11px;}
QLabel#lblEnergiaFinal {background:#E7F0FA; border-radius:8px; color:#1C334D; padding:10px; font-weight:bold;}
QLabel#lblLexico, QLabel#lblSintactico, QLabel#lblSemantico {background:#EDF2F9; border-radius:6px; padding:8px; font-size:11px; color:#637D99;}
QPushButton {background:#FFFFFF; color:#1F3655; border:1px solid #D7E4EF; border-radius:7px; font-weight:600; padding:7px 10px; min-height:23px;}
QPushButton:hover {background:#E5F1FC; border:1px solid #7EB7E6;}
QPushButton:pressed {background:#CCE4F5;}
QPushButton#btnEjecutar {background:#1483D7; border-color:#188ADF; color:white;}
QPushButton#btnAnalizar {background:#1464A5; border-color:#267FB8; color:white;}
QPushButton#btnAST {background:#185FAD; border-color:#2B75C2; color:white;}
QPushButton#btnBlanco, QPushButton#btnAzul {min-width:71px; font-size:11px;}
QPushButton#btnBlanco {background:#D6EAF8; border-color:#D6EAF8; color:#113456;}
QFrame#headerHUD QPushButton#btnBlanco, QFrame#headerHUD QPushButton#btnAzul {color:#DDECFB; background:#153655; border-color:#1C4D7D;}
QFrame#headerHUD QPushButton#btnBlanco {background:#E8F5FF; color:#163753;}
QPlainTextEdit {background:#F9FBFF; color:#19324F; border:1px solid #D9E5F1; border-radius:8px; padding:9px; font-family:Consolas; font-size:13px; selection-background-color:#C6E3FB;}
QPlainTextEdit:focus {border:1px solid #4097DA;}
QLineEdit {background:#F8FBFE; color:#1D344E; border:1px solid #D8E3EF; border-radius:7px; padding:7px 10px; min-height:19px;}
QTableWidget, QTreeWidget {background:#FFFFFF; color:#203852; border:1px solid #DEE7F0; border-radius:8px; gridline-color:#E4EAF2; alternate-background-color:#F4F8FD;}
QTableWidget::item {padding:6px;}
QTreeWidget::item {min-height:28px; padding:3px; border-radius:5px;}
QTreeWidget::item:selected {background:#DDECFB; color:#14599B;}
QHeaderView::section {background:#E7EFF8; color:#4B6582; border:0; border-right:1px solid #D5DFE9; padding:7px; font-size:10px; font-weight:700;}
QScrollBar:vertical, QScrollBar:horizontal {background:#EFF5FB; width:11px; height:11px; border:0;}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {background:#B8CCD9; border-radius:5px; min-height:24px; min-width:24px;}
</string>
