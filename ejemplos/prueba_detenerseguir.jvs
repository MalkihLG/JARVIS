sistema StarkLab {

    mision principal {

        var suma: entero = 0;

        para (var i: entero = 1; i <= 10; i += 1) {

            si (i == 3) {
                seguir;
            }

            si (i == 7) {
                detener;
            }

            imprimir(i);
            suma += i;
        }

        imprimir("SUMA FINAL:");
        imprimir(suma);
    }
}
